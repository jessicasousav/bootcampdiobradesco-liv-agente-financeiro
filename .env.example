# Copie este arquivo para ".env" e preencha UMA das opções abaixo.
# Sem nenhuma chave, o app funciona em MODO OFFLINE (respostas montadas direto da base de conhecimento).

# Opção 1: Claude (Anthropic)
# ANTHROPIC_API_KEY=sua-chave

# Opção 2: OpenAI (ou API compatível, com LLM_BASE_URL)
# OPENAI_API_KEY=sua-chave

# Opção 3: Google Gemini
# GEMINI_API_KEY=sua-chave

# Opção 4: modelo local com Ollama (gratuito; rode antes: ollama pull llama3.2)
# LLM_PROVIDER=ollama

# Opcionais
# LLM_PROVIDER=anthropic|openai|gemini|ollama|none   (se omitido, detecta pela chave definida)
# LLM_MODEL=nome-do-modelo                            (se omitido, usa um padrão de cada provedor)
# LLM_BASE_URL=https://...                            (OpenAI-compatível / Ollama)
